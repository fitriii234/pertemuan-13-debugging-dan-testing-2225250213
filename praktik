def hitung_rata_rata(nilai):
    if not nilai:
        raise ValueError("Daftar nilai kosong.")
    return sum(nilai) / len(nilai)


def status(nilai):
    if not isinstance(nilai, (int, float)):
        raise TypeError("Nilai harus berupa angka.")
    if not 0 <= nilai <= 100:
        raise ValueError("Nilai harus berada pada rentang 0 sampai 100.")
    if nilai >= 60:
        return "Lulus"
    return "Tidak lulus"


def nilai_tertinggi(nilai):
    if not nilai:
        raise ValueError("Daftar nilai kosong.")
    tertinggi = nilai[0]
    for x in nilai:
        if x > tertinggi:
            tertinggi = x
    return tertinggi


def jalankan_test():
    test_cases = [
        ("T1 rata-rata empat data", lambda: hitung_rata_rata([80, 60, 90, 70]), 75.0),
        ("T2 rata-rata dua data", lambda: hitung_rata_rata([100, 80]), 90.0),
        ("T3 status nilai 60", lambda: status(60), "Lulus"),
        ("T4 status nilai 59", lambda: status(59), "Tidak lulus"),
        ("T5 nilai tertinggi", lambda: nilai_tertinggi([80, 60, 90, 70]), 90),
    ]
    semua_lulus = True
    for nama, fungsi, expected in test_cases:
        actual = fungsi()
        lulus = actual == expected
        semua_lulus &= lulus
        print(f"{nama}: expected={expected}, actual={actual} -> {'PASS' if lulus else 'FAIL'}")

    # Test kondisi kosong dan data tidak valid
    for nama, fungsi, error_type in [
        ("Rata-rata kosong", lambda: hitung_rata_rata([]), ValueError),
        ("Tertinggi kosong", lambda: nilai_tertinggi([]), ValueError),
        ("Status di atas 100", lambda: status(120), ValueError),
    ]:
        try:
            fungsi()
        except error_type:
            print(f"{nama}: PASS (exception ditangani)")
        else:
            semua_lulus = False
            print(f"{nama}: FAIL (exception tidak muncul)")
    return semua_lulus


def main():
    nilai = [80, 60, 90, 70]
    print("Rata-rata:", hitung_rata_rata(nilai))
    print("Status 60:", status(60))
    print("Tertinggi:", nilai_tertinggi(nilai))
    print("\n=== RETEST ===")
    jalankan_test()


if __name__ == "__main__":
    main()
